{
  "manifest_version": 3,
  "name": "Order Monitor — Amazon + Flipkart",
  "version": "2.3.2",
  "description": "One place to see the live status of all your active Amazon and Flipkart orders, grouped by bundle.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
  "action": { "default_title": "Active Orders", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.flipkart.com/account/orders*",
        "https://www.amazon.in/gp/css/order-history*",
        "https://www.amazon.in/your-orders/orders*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
